{
    "$comment": "docs/risk-tiers.md is the source; this file restates its tier table as data. scripts/check-policies.mjs fails when the two disagree (tier number, name, paths, required commands, review). Tier 1 is the MOST dangerous tier. Paths are input to a classifier, not the classifier: tier is set by what a change can break, so a reviewer's judgment can raise a tier above the path match but never lower it below. A path glob cannot see inside a file, so the install path of openaudible-autoupdate.sh (checksum verification, sudo, dnf install) is raised to tier 1 by the rule in docs/risk-tiers.md while the file matches tier 2. The path match is conservative: the whole script is reviewed by the owner (tier 2 review is owner too).",
    "default_tier": 3,
    "tiers": [
        {
            "tier": 1,
            "name": "critical",
            "paths": [
                ".github/workflows/**",
                ".github/CODEOWNERS",
                ".github/rulesets/**",
                ".claude/settings.json",
                ".claude/hooks/**",
                "policies/**",
                "scripts/check-policies.mjs",
                "risk-config.json",
                "LICENSE",
                "AGENTS.md"
            ],
            "required_commands": [
                "shellcheck openaudible-autoupdate.sh",
                "bats tests/unit",
                "tests/e2e/run.sh",
                "node scripts/check-policies.mjs",
                "node --test scripts/tests/*.test.mjs"
            ],
            "review": "owner"
        },
        {
            "tier": 2,
            "name": "high",
            "paths": [
                "openaudible-autoupdate.sh",
                "systemd/**",
                "CLAUDE.md",
                ".github/copilot-instructions.md",
                ".cursor/rules/**",
                ".github/prompts/**",
                ".claude/skills/**",
                "docs/risk-tiers.md",
                "docs/agent-boundaries.md",
                "docs/security/**"
            ],
            "required_commands": [
                "shellcheck openaudible-autoupdate.sh",
                "bats tests/unit",
                "node scripts/check-policies.mjs"
            ],
            "review": "owner"
        },
        {
            "tier": 3,
            "name": "medium",
            "paths": [
                "tests/**",
                "scripts/**",
                ".shellcheckrc",
                ".coverage-thresholds.json"
            ],
            "required_commands": [
                "bats tests/unit",
                "node --test scripts/tests/*.test.mjs"
            ],
            "review": "ci"
        },
        {
            "tier": 4,
            "name": "low",
            "paths": [
                "docs/**",
                "*.md",
                ".editorconfig",
                ".gitignore"
            ],
            "required_commands": [],
            "review": "ci"
        }
    ]
}
