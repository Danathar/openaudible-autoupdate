root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,bash,bats}]
# shfmt reads these too.
indent_style = space
indent_size = 2
switch_case_indent = false

[*.mjs]
indent_size = 4

[*.md]
# Trailing double-space is a Markdown line break.
trim_trailing_whitespace = false

[LICENSE]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
